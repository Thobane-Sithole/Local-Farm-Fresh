APP_NAME="Local-Farm-Fresh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Johannesburg
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL (Render PostgreSQL in production)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=local_farm_fresh
DB_USERNAME=postgres
DB_PASSWORD=

# Database-backed sessions, cache and queue: no Redis needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# Mail: "log" locally; SMTP or Resend in production.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@localfarmfresh.co.za"
MAIL_FROM_NAME="${APP_NAME}"

# Product and farmer images (wired up in Phase 2).
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

VITE_APP_NAME="${APP_NAME}"
